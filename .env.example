# ============================================================
# OakstrattonIMA — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# App
APP_NAME=OakstrattonIMA
ENVIRONMENT=development
DEBUG=true

# Security — generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-in-production

# Database (Railway PostgreSQL)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/oakstratton_ima

# Redis (Railway Redis)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS — comma-separated origins for your frontend
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Frontend URL (used in email links)
FRONTEND_URL=http://localhost:5173

# ---- Email (SendGrid) ----
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@oakstrattonima.com
EMAIL_FROM_NAME=OakstrattonIMA

# ---- Payments (Stripe) ----
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
STRIPE_CONNECT_CLIENT_ID=ca_xxxxxxxxxxxxxxxxxxxx

# ---- Social Media APIs ----

# Instagram / Facebook Graph API
# https://developers.facebook.com/
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# TikTok for Developers
# https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# YouTube Data API v3
# https://console.cloud.google.com/
YOUTUBE_API_KEY=

# Twitter/X API Bearer Token
# https://developer.twitter.com/
TWITTER_BEARER_TOKEN=

# ---- File Storage (S3-Compatible) ----
# For AWS S3, Cloudflare R2, MinIO, etc.
S3_BUCKET_NAME=oakstratton-ima-media
S3_ENDPOINT_URL=           # Leave blank for AWS S3, set for R2/MinIO
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ---- Database Pool ----
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# AI (Anthropic Claude)
ANTHROPIC_API_KEY=sk-ant-your-key-here
AI_MODEL=claude-sonnet-4-6
AI_MAX_TOKENS=4096
